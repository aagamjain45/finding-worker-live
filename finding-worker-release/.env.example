# ── Finding Worker Backend — Environment Variables ──
#
# Database (MySQL) — For Render, use an external cloud MySQL provider (Aiven, Clever Cloud, TiDB Cloud, etc.)
# Example: jdbc:mysql://your-db-host.aivencloud.com:port/finding_worker?sslmode=require
DB_URL=jdbc:mysql://localhost:3306/finding_worker
DB_USERNAME=root
DB_PASSWORD=your_password

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Frontend URL (for CORS and OAuth2 redirect) — DO NOT include a trailing slash!
# Production example: https://finding-worker.vercel.app
# Local development:  http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Session Cookies (Must be 'none' and 'true' for production HTTPS deployment)
SESSION_COOKIE_SAME_SITE=none
SESSION_COOKIE_SECURE=true

# JPA / Hibernate SQL logging (false in production)
JPA_SHOW_SQL=false
